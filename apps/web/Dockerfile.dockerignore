# Ignore rules for apps/web/Dockerfile (build context = repository root).
# Allow-list: only what the web build needs is sent to Docker.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!apps/web/
apps/web/node_modules/
apps/web/.next/
apps/web/.env
apps/web/.env.*
apps/web/tsconfig.tsbuildinfo
apps/web/next-env.d.ts
apps/web/Dockerfile*
