# AI LeadFlow web app — copy to `.env.local` (git-ignored).
# Only NON-SECRET values may use the NEXT_PUBLIC_ prefix: they are inlined into
# the JavaScript sent to browsers at `next build` time.

# Base URL of the API. Defaults to http://localhost:8000 in development;
# required for production builds.
NEXT_PUBLIC_API_URL=http://localhost:8000
