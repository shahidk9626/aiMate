# AI LeadFlow — local environment template.
# Copy to `.env` and replace every `change-me` value. `.env` is git-ignored.
# Only names and safe placeholders belong in this file — never real secrets.

# --- Runtime -----------------------------------------------------------------
APP_ENV=local

# --- PostgreSQL ----------------------------------------------------------------
# Used by infra/docker-compose.yml AND by the API (apps/api reads this file).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=leadflow
# Owner role: creates the database, runs migrations and the role bootstrap.
# Never give these to the running API/worker in staging or production.
POSTGRES_USER=leadflow_owner
POSTGRES_PASSWORD=change-me

# Runtime role used by the API and worker: no superuser, no BYPASSRLS, no DDL.
# Created/updated by: (cd apps/api && uv run python -m app.db.bootstrap)
APP_DB_USER=leadflow_app
APP_DB_PASSWORD=change-me

# --- Redis -------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me

# --- API ---------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_JSON=true   # default: human-readable when APP_ENV=local, JSON otherwise

# The only browser origin allowed to call the API (CORS). Exactly one origin.
# Open the web app at this exact address (localhost, not 127.0.0.1).
WEB_ORIGIN=http://localhost:3000

# The web app has its own settings file: apps/web/.env.example

# Added in later steps (see docs/SETUP_GUIDE.md):
# JWT_SECRET, CREDENTIALS_MASTER_KEY, CREDENTIALS_KEY_VERSION, COOKIE_DOMAIN
