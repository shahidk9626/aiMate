# AI LeadFlow — local environment template.
# Copy to `.env` and replace every `change-me` value. `.env` is git-ignored.
# Only names and safe placeholders belong in this file — never real secrets.

# --- Runtime -----------------------------------------------------------------
APP_ENV=local

# --- PostgreSQL (infra/docker-compose.yml) ------------------------------------
# Owner role: creates the database and runs migrations. Not used by the app at
# runtime once the RLS-restricted app role exists (Stage 1, step 3).
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow_owner
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Redis (infra/docker-compose.yml) -----------------------------------------
REDIS_PASSWORD=change-me
REDIS_PORT=6379

# Added in later steps (see docs/SETUP_GUIDE.md):
# DATABASE_URL, DATABASE_MIGRATION_URL, REDIS_URL, JWT_SECRET,
# CREDENTIALS_MASTER_KEY, CREDENTIALS_KEY_VERSION, WEB_ORIGIN, COOKIE_DOMAIN,
# NEXT_PUBLIC_API_URL
